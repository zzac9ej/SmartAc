{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "AdminToken": "YOUR_ADMIN_RANDOM_TOKEN",
    "GuestToken": "YOUR_GUEST_RANDOM_TOKEN",
    "GuestRoomId": "office"
  },
  "Rooms": [
    { "Id": "home",   "Name": "家裡",   "MqttTopic": "home/livingroom/ac" },
    { "Id": "office", "Name": "辦公室", "MqttTopic": "office/ac" }
  ],
  "QStash": {
    "BaseUrl": "https://qstash-eu-central-1.upstash.io",
    "Token": "YOUR_UPSTASH_QSTASH_TOKEN_HERE",
    "CallbackUrl": "https://your-api-url.com/api/callback",
    "CurrentSigningKey": "YOUR_CURRENT_SIGNING_KEY_HERE",
    "NextSigningKey": "YOUR_NEXT_SIGNING_KEY_HERE"
  },
  "MQTT": {
    "Broker": "broker.hivemq.com",
    "Port": 1883,
    "Topic": "home/livingroom/ac"
  }
}
